      if(img){img.src=preview.src;img.alt=result.imageName}
      const fn=$('scanResultImageName');if(fn)fn.textContent=result.imageName;
      if(typeof saveHistory==='function')saveHistory(result);
      if(typeof showFertilizerSuggestion==='function')showFertilizerSuggestion(result);
      if(typeof renderAdvisory==='function')renderAdvisory();
      if(typeof updateDashboardMetrics==='function')updateDashboardMetrics();
      if(loader)loader.style.display='none';if(btn)btn.disabled=false;
      work.remove();toast('Crop image analyzed successfully 🌱');
    },900);
  }
  const analyze=$('analyzeBtn');if(analyze)analyze.onclick=doAnalysis;

  function attachFileHandlers(){
    const camera=$('cameraInput'),upload=$('galleryInput');
    function chosen(file){
