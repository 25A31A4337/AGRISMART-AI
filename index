function updateCurrentLocation(){
 const loc=document.getElementById('weatherLocation');if(!loc)return;let status=document.getElementById('locationStatus');if(!status){status=document.createElement('small');status.id='locationStatus';status.style.opacity='.9';loc.parentNode.appendChild(document.createElement('br'));loc.parentNode.appendChild(status);}
 if(!navigator.geolocation){loc.textContent='Location unavailable';return;}
 if(status)status.textContent='Requesting your current location…';
 navigator.geolocation.getCurrentPosition(pos=>{
  const lat=pos.coords.latitude,lon=pos.coords.longitude;loc.textContent=`${lat.toFixed(5)}, ${lon.toFixed(5)}`;if(status)status.textContent='Your current location is detected.';
  fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lon}`,{headers:{'Accept-Language':language}}).then(r=>r.json()).then(d=>{const a=d.address||{},place=a.city||a.town||a.village||a.county||a.state;loc.textContent=place?(place+(a.state?', '+a.state:'')):`${lat.toFixed(5)}, ${lon.toFixed(5)}`;}).catch(()=>{});
 },()=>{if(status)status.textContent=language==='te'?'స్థానం అనుమతించబడలేదు.':language==='hi'?'स्थान की अनुमति नहीं मिली।':'Location permission was not granted.';},{enableHighAccuracy:true,timeout:15000,maximumAge:300000});
}
