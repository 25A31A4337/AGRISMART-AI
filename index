  function tr(s,lang){
    if(!s)return s;
    return (LANG[lang]&&LANG[lang][s]) || (TERM[lang]&&TERM[lang][s]) || (DESC[lang]&&DESC[lang][s]) || (SCAN_TEXT[lang]&&SCAN_TEXT[lang][s]) || s;
  }
  window.__agrTr=tr;

