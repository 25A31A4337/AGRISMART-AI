<script>
/* Final visual correction: real fertilizer photos + reliable crop name display. */
(function(){
  const $=id=>document.getElementById(id);
  const PHOTO={
    npk:'https://upload.wikimedia.org/wikipedia/commons/thumb/c/c3/NPK_19-19-19_Fertilizer_%281%29.jpg/1280px-NPK_19-19-19_Fertilizer_%281%29.jpg',
    urea:'https://upload.wikimedia.org/wikipedia/commons/thumb/7/70/Sample_of_Urea.jpg/250px-Sample_of_Urea.jpg',
    potash:'https://upload.wikimedia.org/wikipedia/commons/thumb/4/4d/Particles_of_potash.jpg/1280px-Particles_of_potash.jpg',
    dap:'https://upload.wikimedia.org/wikipedia/commons/thumb/6/63/DAP_18_46_0.jpg/840px-DAP_18_46_0.jpg',
    compost:'https://upload.wikimedia.org/wikipedia/commons/thumb/8/8e/Compost_.jpg/960px-Compost_.jpg'
  };
  const esc=x=>String(x??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
  function photoFor(name){
    const n=String(name||'').toLowerCase();
    if(n.includes('urea')||n.includes('nitrogen')) return PHOTO.urea;
    if(n.includes('dap')) return PHOTO.dap;
    if(n.includes('potash')||n.includes('potassium')||n.includes('mop')) return PHOTO.potash;
    if(n.includes('compost')||n.includes('organic')) return PHOTO.compost;
    return PHOTO.npk;
  }
  function makeFertilizerPhotos(){
    const box=$('fertilizerSuggestion'); if(!box)return;
    box.querySelectorAll('.fert-item').forEach(item=>{
      const name=item.querySelector('.fert-copy b')?.textContent||'';
      const holder=item.querySelector('.fert-image'); if(!holder)return;
      holder.innerHTML='<img loading="lazy" src="'+photoFor(name)+'" alt="'+esc(name)+' fertilizer photo" onerror="this.style.display=\'none\'">';
    });
  }
  const oldShow=window.showFertilizerSuggestion;
  if(typeof oldShow==='function'){
    window.showFertilizerSuggestion=function(result){oldShow(result);setTimeout(makeFertilizerPhotos,0);};
  }
  function cropFromFile(name){
    const n=String(name||'').toLowerCase().replace(/[_.-]+/g,' ');
    const aliases={tomato:'Tomato',potato:'Potato',chilli:'Chilli',chili:'Chilli',cotton:'Cotton',rice:'Rice',wheat:'Wheat',brinjal:'Brinjal',eggplant:'Brinjal',okra:'Okra',ladyfinger:'Okra',groundnut:'Groundnut',peanut:'Groundnut',maize:'Maize',corn:'Maize',soybean:'Soybean',sugarcane:'Sugarcane',onion:'Onion',cabbage:'Cabbage',cauliflower:'Cauliflower',banana:'Banana',mango:'Mango',grape:'Grape'};
    for(const k in aliases) if(n.includes(k)) return aliases[k];
    return '';
  }
  function showCropIdentity(result){
    const target=$('scanResult'); if(!target)return;
    let card=$('scanCropIdentity');
    if(!card){card=document.createElement('div');card.id='scanCropIdentity';card.className='scan-crop-identity';const grid=target.querySelector('.grid');if(grid)target.insertBefore(card,grid);else target.prepend(card)}
    let crop=String(result?.crop||'').trim();
    if(!crop||crop==='Crop image') crop=cropFromFile(result?.imageName||window.__agrishieldCurrentFile||'');
    if(!crop) crop='Crop not identified';
    card.innerHTML='<div class="crop-icon">🌱</div><div><div class="crop-label">Scanned crop</div><div class="crop-value">'+esc(crop)+'</div></div>';
    const rc=$('resultCrop');if(rc)rc.textContent=crop;
    if(result)result.crop=crop;
  }
  window.__showCropIdentity=showCropIdentity;
  function refreshResult(){
    let result=window.latestScan;
    if(!result){try{result=JSON.parse(localStorage.getItem('agrishieldLatestScan')||'null')}catch(e){}}
    if(result){showCropIdentity(result);makeFertilizerPhotos();}
  }
  /* Wrap the current analysis function so the crop identity is refreshed after the result appears. */
  const btn=$('analyzeBtn');
  if(btn){btn.addEventListener('click',()=>setTimeout(()=>{refreshResult();makeFertilizerPhotos()},1100));}
  document.addEventListener('click',()=>setTimeout(()=>{if($('scanResult')?.style.display!=='none')refreshResult()},80));
  window.addEventListener('load',()=>setTimeout(refreshResult,300));
  setTimeout(refreshResult,200);
})();
</script>


