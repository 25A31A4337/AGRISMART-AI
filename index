      box.innerHTML='<button type="button" class="camera-option take" id="directCameraButton">📷 <span>Camera</span></button><label class="camera-option gallery" id="uploadImageButton" for="galleryInput">🖼️ <span>Upload Image</span></label>';
      $('directCameraButton').onclick=()=>{if(typeof openLiveCamera==='function')openLiveCamera();else camera.click()};
    }
  }
  attachFileHandlers();

  /* Make the first screen dynamic immediately and after every navigation. */
  window.addEventListener('load',()=>{setTimeout(()=>{if(typeof updateDashboardMetrics==='function')updateDashboardMetrics()},100)});
  document.addEventListener('click',()=>setTimeout(()=>{if(typeof updateDashboardMetrics==='function')updateDashboardMetrics()},120));

