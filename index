<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>AgriShield | Smart Crop Protection</title>

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>
:root{
--green:#078b2d;
--dark:#07551d;
--light:#f5f7fb;
--card:#fff;
--text:#20252b;
--muted:#70757d;
--border:#e3e6eb;
--danger:#ed1b2f;
--warning:#ff8a00;
--success:#0a9b3e;
--shadow:0 10px 28px rgba(0,0,0,.08)
}

*{
box-sizing:border-box;
margin:0;
padding:0
}

html{
scroll-behavior:smooth
}

body{
font-family:Inter,Arial,sans-serif;
background:var(--light);
color:var(--text);
min-height:100vh;
padding-bottom:75px;
overflow-x:hidden
}

body.dark{
--light:#07130a;
--card:#102017;
--text:#eaf5ed;
--muted:#aab9ae;
--border:#27432e;
--shadow:0 10px 28px rgba(0,0,0,.3)
}

/* HEADER */

header{
height:68px;
background:linear-gradient(135deg,#004d18,#078b2d);
color:#fff;
padding:0 5%;
display:flex;
align-items:center;
justify-content:space-between;
position:sticky;
top:0;
z-index:1000;
box-shadow:0 4px 16px rgba(0,70,20,.25)
}

.logo{
font-size:25px;
font-weight:900
}

.logo span{
color:#c8ffd5
}

.header-actions{
display:flex;
align-items:center;
gap:9px
}

.round-btn{
width:40px;
height:40px;
border:0;
border-radius:50%;
background:#ffffff20;
color:#fff;
cursor:pointer;
font-size:18px
}

.profile-mini{
padding:9px 14px;
border-radius:22px;
background:#ffffff1c;
cursor:pointer;
font-weight:700
}

/* SECTIONS */

section{
max-width:1050px;
margin:auto;
padding:28px 5%;
display:none;
animation:fade .25s ease
}

section.active{
display:block
}

@keyframes fade{
from{
opacity:0;
transform:translateY(8px)
}
to{
opacity:1;
transform:none
}
}

.title{
font-size:30px;
font-weight:900;
margin-bottom:5px
}

.subtitle{
color:var(--muted);
margin-bottom:22px;
line-height:1.5
}

.back-btn{
border:0;
background:transparent;
color:var(--green);
font-size:18px;
font-weight:900;
cursor:pointer;
padding:5px 0 12px
}

.form-group{
margin-bottom:15px
}

label{
display:block;
font-weight:800;
margin-bottom:6px
}

input,
select,
textarea{
width:100%;
padding:12px;
border:1px solid var(--border);
border-radius:10px;
background:var(--card);
color:var(--text);
font-size:15px;
outline:none
}

input:focus,
select:focus,
textarea:focus{
border-color:var(--green);
box-shadow:0 0 0 3px #078b2d18
}

.btn{
border:0;
background:var(--green);
color:#fff;
padding:12px 18px;
border-radius:10px;
cursor:pointer;
font-weight:800;
transition:.2s
}

.btn:hover{
transform:translateY(-2px);
box-shadow:0 7px 18px #078b2d30
}

.btn.secondary{
background:#e4f4e8;
color:var(--green)
}

.btn.orange{
background:var(--warning)
}

.btn.red{
background:var(--danger)
}

.full{
width:100%
}

.login-switch{
text-align:center;
margin-top:18px;
color:#777
}

.login-switch button{
border:0;
background:none;
color:var(--green);
font-weight:900;
cursor:pointer
}

/* HERO */

.hero{
background:linear-gradient(135deg,#dff6e5,#f8fff9);
border:1px solid #cce9d3;
border-radius:24px;
padding:34px;
margin-bottom:20px;
box-shadow:var(--shadow)
}

body.dark .hero{
background:#102e18;
border-color:#27432e
}

.hero h1{
font-size:39px;
max-width:760px;
color:var(--dark);
margin-bottom:10px
}

body.dark .hero h1{
color:#91f0a5
}

.hero p{
max-width:720px;
color:var(--muted);
line-height:1.65
}

.hero-buttons{
display:flex;
gap:10px;
flex-wrap:wrap;
margin-top:20px
}

/* CARDS */

.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(210px,1fr));
gap:16px
}

.card{
background:var(--card);
border:1px solid var(--border);
border-radius:18px;
padding:20px;
box-shadow:var(--shadow);
margin-bottom:16px
}

.card h3{
margin:8px 0;
color:var(--green)
}

.card p{
line-height:1.5
}

.icon{
font-size:31px
}

/* STATS */

.stats{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(165px,1fr));
gap:14px;
margin-bottom:20px
}

.stat-card{
background:var(--card);
border:1px solid var(--border);
border-radius:16px;
padding:18px;
box-shadow:var(--shadow);
position:relative;
overflow:hidden
}

.stat-card:before{
content:"";
position:absolute;
left:0;
top:0;
width:4px;
height:100%;
background:var(--green)
}

.stat-number{
font-size:30px;
font-weight:900;
margin:6px 0
}

.progress{
height:10px;
background:#e9edf0;
border-radius:20px;
overflow:hidden;
margin:9px 0 12px
}

.progress div{
height:100%;
background:linear-gradient(90deg,#0a9b3e,#69d985);
border-radius:20px;
transition:1s
}

.badge{
display:inline-block;
padding:5px 10px;
border-radius:8px;
font-size:12px;
font-weight:900
}

.green{
background:#dff6e6;
color:#08762b
}

.yellow{
background:#fff0d2;
color:#a96500
}

.red{
background:#ffe1e4;
color:#b91528
}

/* CAMERA */

.camera-container{
background:var(--card);
border:2px dashed #72b97f;
border-radius:20px;
padding:30px 20px;
text-align:center
}

.camera-icon{
font-size:58px;
margin-bottom:10px
}

.hidden-file{
display:none
}

.camera-options{
display:grid;
grid-template-columns:1fr 1fr;
gap:12px;
max-width:550px;
margin:20px auto
}

.camera-option{
border:0;
padding:16px;
border-radius:14px;
font-weight:900;
cursor:pointer;
font-size:15px
}

.camera-option.take{
background:var(--green);
color:#fff
}

.camera-option.gallery{
background:#e4f4e8;
color:var(--green)
}

#preview{
display:none;
max-width:100%;
max-height:330px;
margin:18px auto;
border-radius:16px;
object-fit:contain
}

.image-name{
font-size:13px;
color:var(--muted);
margin:8px
}

.scan-loader{
display:none;
margin:18px auto;
width:52px;
height:52px;
border:6px solid #d9eadc;
border-top-color:var(--green);
border-radius:50%;
animation:spin 1s linear infinite
}

@keyframes spin{
to{
transform:rotate(360deg)
}
}

.result{
display:none;
border-left:5px solid var(--danger)
}

/* WEATHER */

.weather-main{
background:linear-gradient(135deg,#1687c9,#65bce9);
color:#fff;
border-radius:20px;
padding:24px;
margin-bottom:18px;
box-shadow:var(--shadow)
}

.weather-temp{
font-size:54px;
font-weight:900
}

.weather-grid{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:10px;
margin-top:18px
}

.weather-item{
background:#ffffff20;
border-radius:12px;
padding:12px
}

.forecast{
display:grid;
grid-template-columns:repeat(5,1fr);
gap:9px
}

.forecast-day{
background:var(--card);
border:1px solid var(--border);
border-radius:14px;
padding:13px;
text-align:center;
box-shadow:var(--shadow)
}

/* ALERTS */

.alert{
display:flex;
align-items:flex-start;
gap:13px;
padding:16px;
border-radius:14px;
margin-bottom:12px
}

.alert.high{
background:#ffe7e9;
border-left:5px solid var(--danger);
color:#6f1d26
}

.alert.medium{
background:#fff1d9;
border-left:5px solid var(--warning);
color:#72510d
}

.alert.low{
background:#e4f7e9;
border-left:5px solid var(--success);
color:#17632e
}

/* HISTORY */

.table-wrap{
overflow-x:auto
}

.history-table{
width:100%;
border-collapse:collapse;
min-width:650px
}

.history-table th,
.history-table td{
padding:12px;
border-bottom:1px solid var(--border);
text-align:left
}

.history-table th{
background:var(--green);
color:#fff
}

.chart{
height:220px;
position:relative;
padding:20px 10px 34px;
border-bottom:1px solid var(--border)
}

.chart svg{
width:100%;
height:100%
}

.line{
fill:none;
stroke:#078b2d;
stroke-width:3;
stroke-linecap:round;
stroke-linejoin:round
}

.line-point{
fill:var(--green)
}

.chart-labels{
display:flex;
justify-content:space-between;
font-size:11px;
color:var(--muted);
gap:8px;
overflow-x:auto
}

/* DOCUMENTS */

.document-card{
display:flex;
align-items:center;
gap:16px
}

.document-icon{
width:58px;
height:58px;
border-radius:15px;
background:#e4f4e8;
color:var(--green);
display:flex;
align-items:center;
justify-content:center;
font-size:25px;
flex-shrink:0
}

.document-info{
flex:1
}

.document-info h3{
margin:0 0 5px
}

.document-info p{
font-size:13px;
color:var(--muted)
}

.document-actions{
display:flex;
gap:7px;
flex-wrap:wrap
}

.document-actions button{
padding:8px 11px;
border:0;
border-radius:8px;
cursor:pointer;
font-weight:700
}

.view-doc{
background:#e4f4e8;
color:var(--green)
}

.delete-doc{
background:#ffe1e4;
color:#b91528
}

.empty{
text-align:center;
padding:40px 20px
}

/* MENU */

.menu-grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:12px
}

.menu-btn{
border:0;
background:var(--green);
color:#fff;
padding:14px;
border-radius:11px;
font-weight:800;
cursor:pointer
}

/* BOTTOM NAV */

.bottom-nav{
position:fixed;
left:8px;
right:8px;
bottom:0;
height:64px;
background:#fff;
display:flex;
align-items:center;
justify-content:space-around;
z-index:2000;
border:1px solid #d9d9d9;
border-bottom:0;
border-radius:8px 8px 0 0;
box-shadow:0 -3px 12px rgba(0,0,0,.09);
overflow-x:auto
}

.bottom-nav button{
min-width:65px;
flex:1;
height:100%;
border:0;
background:transparent;
color:#777;
display:flex;
flex-direction:column;
align-items:center;
justify-content:center;
gap:4px;
cursor:pointer;
font-size:10px
}

.bottom-nav i{
font-size:18px
}

.bottom-nav button.active{
color:var(--green);
font-weight:800
}

body.dark .bottom-nav{
background:#102017;
border-color:#27432e
}

body.dark .bottom-nav button{
color:#9eb0a4
}

body.dark .bottom-nav button.active{
color:#72e88e
}

/* MODALS */

.modal{
position:fixed;
inset:0;
background:#0008;
display:none;
align-items:center;
justify-content:center;
padding:20px;
z-index:5000
}

.modal.show{
display:flex
}

.modal-box{
background:var(--card);
color:var(--text);
width:min(600px,95vw);
max-height:85vh;
overflow:auto;
border-radius:20px;
padding:25px;
box-shadow:0 20px 60px #0005
}

.modal-header{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:18px
}

.close-modal{
border:0;
background:#eee;
width:35px;
height:35px;
border-radius:50%;
cursor:pointer;
font-size:20px
}

body.dark .close-modal{
background:#24372a;
color:#fff
}

/* LANGUAGE */

.language-options{
display:grid;
gap:10px
}

.language-option{
border:1px solid var(--border);
background:var(--card);
color:var(--text);
padding:15px;
border-radius:12px;
font-weight:800;
cursor:pointer;
text-align:left;
font-size:15px
}

.language-option:hover{
border-color:var(--green);
background:#e4f4e8;
color:var(--green)
}

/* TOAST */

#toast{
position:fixed;
right:20px;
bottom:82px;
background:#123c20;
color:#fff;
padding:13px 17px;
border-radius:12px;
box-shadow:0 10px 30px #0004;
transform:translateY(100px);
opacity:0;
transition:.3s;
z-index:6000
}

#toast.show{
transform:none;
opacity:1
}

/* MOBILE */

@media(max-width:650px){

header{
height:62px;
padding:0 4%
}

.logo{
font-size:21px
}

.profile-mini{
display:none
}

section{
padding:22px 4%
}

.title{
font-size:25px
}

.hero{
padding:25px 20px
}

.hero h1{
font-size:29px
}

.weather-grid{
grid-template-columns:repeat(2,1fr)
}

.forecast{
grid-template-columns:repeat(5,minmax(72px,1fr));
overflow-x:auto
}

.menu-grid{
grid-template-columns:1fr 1fr
}

.camera-options{
grid-template-columns:1fr
}

.document-card{
align-items:flex-start;
flex-direction:column
}

.document-actions{
width:100%
}

.bottom-nav button{
min-width:60px
}

}

/* FINAL FIXES */
@media(max-width:650px){.profile-mini{display:block!important;font-size:12px;padding:7px 10px;max-width:125px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.header-actions{gap:6px}}
.camera-option.gallery,#galleryInput{display:none!important}
.camera-options{grid-template-columns:1fr!important;max-width:360px!important;margin:20px auto!important}
#liveCamera video{width:100%;border-radius:15px;background:#000;max-height:65vh}

    .fert-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin-top:14px}.fert-item{display:flex;gap:14px;align-items:center;padding:14px;border:1px solid rgba(90,120,100,.18);border-radius:18px;background:rgba(255,255,255,.72);box-shadow:0 8px 24px rgba(30,60,40,.07);transition:transform .25s ease,box-shadow .25s ease}.fert-item:hover{transform:translateY(-4px);box-shadow:0 14px 30px rgba(30,60,40,.12)}.fert-image{width:76px;height:76px;min-width:76px;display:grid;place-items:center;border-radius:16px;background:linear-gradient(145deg,rgba(76,175,80,.12),rgba(255,193,7,.12));color:var(--primary,#2e7d32);overflow:hidden}.fert-image svg{width:68px;height:68px}.fert-copy{display:flex;flex-direction:column;gap:6px}.fert-copy b{font-size:15px}.fert-copy span{font-size:13px;line-height:1.45;opacity:.78}.fert-note{margin-top:14px}
</style>
</head>

