    analyze.parentNode.insertBefore(wrap,analyze);

    const crop=document.getElementById('scanCropInput');
    const file=document.getElementById('cameraInput');
    function inferCrop(name){
      const n=(name||'').toLowerCase();
      const found=cropOptions.find(c=>n.includes(c.toLowerCase()));
      if(found){crop.value=found;}
    }
    if(file) file.addEventListener('change',function(){
      if(this.files && this.files[0]) inferCrop(this.files[0].name);
    });
    window.__agrishieldInferCrop=inferCrop;
  }
  addScanInputs();

  /* Make the camera control visible and dependable. */
  const camBox=document.querySelector('.camera-options');
  const camInput=document.getElementById('cameraInput');
  if(camBox && camInput && !document.getElementById('directCameraButton')){
    camBox.innerHTML=`<button type="button" class="camera-option take" id="directCameraButton">📷 <span>Open Camera</span></button>`;
    document.getElementById('directCameraButton').onclick=function(){
      camInput.setAttribute('capture','environment');
      camInput.click();
    };
  }

  /* Keep the actual selected filename visible. */
  if(camInput){
    camInput.addEventListener('change',function(){
      const f=this.files && this.files[0];
      if(!f)return;
      const name=document.getElementById('imageName');
      if(name) name.textContent='Selected image: '+f.name;
      if(window.__agrishieldInferCrop) window.__agrishieldInferCrop(f.name);
    });
  }

  /* Remove every demo pest card/report from the visible UI. */
  function clearDemoPests(){
    const section=document.getElementById('pest');
    if(!section)return;
    const cards=section.querySelectorAll('.card');
    cards.forEach(card=>{
      const h=card.querySelector('h3');
      const txt=(card.textContent||'').trim();
      if(h && h.textContent.trim()==='Pest Scan') card.style.display='none';
      if(h && h.textContent.trim()==='Recent Reports'){
        [...card.children].forEach(ch=>{
          if(ch.tagName!=='H3' && ch.id!=='recentPestReports') ch.remove();
        });
        if(!card.querySelector('#recentPestReports')){
          const box=document.createElement('div');box.id='recentPestReports';card.appendChild(box);
        }
      }
    });
    const pc=document.getElementById('pestCards');
