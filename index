    const lang=typeof language!=='undefined'?language:'en';
    more.querySelector('h4').textContent=lang==='te'?'మరిన్ని ఎరువుల ఎంపికలు':lang==='hi'?'अधिक उर्वरक विकल्प':'More fertilizer options';
    more.querySelectorAll('b,span').forEach(el=>{const base=el.getAttribute('data-en-text')||el.textContent;el.textContent=typeof window.__agrTr==='function'?window.__agrTr(base,lang):base;});
  }

  /* Add Azogen to nutrient-stress recommendations; it is not presented as a disease cure. */
  const nutrientKey='Nutrient Stress';
  if(typeof fertilizerMap!=='undefined' && fertilizerMap[nutrientKey] && !fertilizerMap[nutrientKey].some(x=>x[0]==='Azogen Biofertilizer')){
    fertilizerMap[nutrientKey].push(['Azogen Biofertilizer','Nitrogen-fixing biofertilizer; use according to the product label and crop recommendation.']);
    if(typeof fertilizerImages!=='undefined') fertilizerImages['Azogen Biofertilizer']='';
  }

  /* Make the current fertilizer renderer produce photo cards. */
  if(typeof showFertilizerSuggestion==='function'){
    const currentShow=showFertilizerSuggestion;
    window.showFertilizerSuggestion=function(result){
      currentShow(result);
      setTimeout(refreshFertilizerPhotos,0);
      setTimeout(()=>translateDynamic(language),0);
    };
  }

  /* Patch applyLanguage LAST so newly-rendered scan/advisory content is translated immediately. */
  if(typeof applyLanguage==='function'){
    const previousApplyLanguage=applyLanguage;
    applyLanguage=function(lang){
      previousApplyLanguage(lang);
      setTimeout(()=>{
        translateWholePage(lang);
        translateDynamic(lang);
        refreshFertilizerPhotos();
        addMoreFertilizerPhotos();
      },0);
    };
  }

  /* Mutation observer catches content created after an image scan. */
  const scan=$('scanResult');
  if(scan){
    const ob=new MutationObserver(()=>{
      clearTimeout(window.__agrLangTimer);
      window.__agrLangTimer=setTimeout(()=>{
        if(typeof language!=='undefined')translateDynamic(language);
        refreshFertilizerPhotos();
        addMoreFertilizerPhotos();
      },30);
    });
    ob.observe(scan,{subtree:true,childList:true,characterData:true});
  }

  /* If a result already exists, localize it on startup. */
  setTimeout(()=>{
    if(typeof language!=='undefined'){
      translateWholePage(language);
      translateDynamic(language);
      refreshFertilizerPhotos();
      addMoreFertilizerPhotos();
    }
  },100);
})();
</script>


