  }

  /* Replace fertilizer image area with real product photographs. */
  function refreshFertilizerPhotos(){
    const box=$('fertilizerSuggestion');if(!box)return;
    box.querySelectorAll('.fert-item').forEach(item=>{
      const title=item.querySelector('.fert-copy b');const holder=item.querySelector('.fert-image');if(!title||!holder)return;
      const name=title.dataset.enText||title.textContent;
      const src=REAL_FERT_PHOTOS[name]||REAL_FERT_PHOTOS['Balanced NPK'];
      holder.innerHTML='<img loading="lazy" src="'+src+'" alt="'+String(name).replace(/"/g,'&quot;')+' fertilizer product photo"><div class="fert-photo-label">Product photo</div>';
    });
  }

  /* Show additional real product-style fertilizer photos, so farmers can recognize packages visually. */
  function addMoreFertilizerPhotos(){
    const box=$('fertilizerSuggestion'); if(!box)return;
    let more=box.querySelector('.fert-more');
    if(!more){
      more=document.createElement('div'); more.className='fert-more';
      more.innerHTML='<h4>More fertilizer options</h4><div class="fert-more-grid"></div>';
      box.appendChild(more);
    }
    const catalog=[
      ['Azogen Biofertilizer','Nitrogen-fixing biofertilizer; follow the product label.'],
      ['NPK Bio Fertilizer','Biofertilizer for balanced nutrient support; follow the product label.'],
      ['Potaz Organic Biofertilizer','Potash-mobilizing biofertilizer; use only as labeled.'],
      ['Nano DAP','Nitrogen and phosphorus fertilizer; use only as recommended for the crop.'],
      ['Bio Zinc','Zinc biofertilizer for confirmed zinc deficiency; follow the label.'],
      ['Zinc Tral','Micronutrient product for zinc-related nutrition; confirm deficiency first.']
    ];
    const grid=more.querySelector('.fert-more-grid');
