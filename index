        if(typeof latestScan!=='undefined' && latestScan){
          const fieldMap={resultCrop:'crop',resultDetection:'detection',resultSymptoms:'symptoms',resultRecommendation:'recommendation',resultSeverity:'severity'};
          if(fieldMap[id] && latestScan[fieldMap[id]]) canonical=latestScan[fieldMap[id]];
        }
      }catch(e){}
      el.dataset.enText=canonical;
      el.textContent=tr(canonical,lang);
    });

    const identity=$('scanCropIdentity');
    if(identity){
      const label=identity.querySelector('.crop-label'); if(label)label.textContent=tr('Scanned crop',lang);
