  /* More pest choices; none are treated as an existing observation. */
  const pestNames=['Fruit Fly','Whitefly','Aphids','Caterpillar','Thrips','Stem Borer','Leaf Miner','Mealybug','Red Spider Mite','Brown Planthopper','Fall Armyworm','Pod Borer','Jassid','Rice Hispa','Termite','White Grub','Shoot Borer','Fruit Borer','Armyworm','Cutworm','Scale Insect','Mirid Bug'];
  const pestSelect=document.getElementById('pestName');
  if(pestSelect){
    pestSelect.innerHTML=pestNames.map(x=>`<option>${x}</option>`).join('');
  }

  /* Scan result is based on the user's selected crop + disease, never random. */
  const analyze=document.getElementById('analyzeBtn');
  if(analyze){
    analyze.onclick=function(){
      const preview=document.getElementById('preview');
      if(!preview || !preview.src || preview.style.display==='none'){
        toast('Please take or select a crop photo first'); return;
      }
      const crop=document.getElementById('scanCropInput').value;
      const disease=document.getElementById('scanDiseaseInput').value;
      if(!crop){toast('Please select the crop you scanned');return;}
      if(!disease){toast('Please select the disease / detection');return;}
      const info=diseaseInfo[disease] || {severity:'MODERATE',confidence:'—',symptoms:'No symptom details provided.',recommendation:'Inspect the crop closely and follow locally approved management guidance.'};
      const result={crop,detection:disease,confidence:info.confidence,severity:info.severity,symptoms:info.symptoms,recommendation:info.recommendation};
      const loader=document.getElementById('loader');
      loader.style.display='block';analyze.disabled=true;
      setTimeout(()=>{
        latestScan=result;
        document.getElementById('resultCrop').textContent=result.crop;
        document.getElementById('resultDetection').textContent=result.detection;
        document.getElementById('resultConfidence').textContent=result.confidence;
        document.getElementById('resultSymptoms').textContent=result.symptoms;
        document.getElementById('resultRecommendation').textContent=result.recommendation;
        const sev=document.getElementById('resultSeverity');sev.textContent=result.severity;sev.className='badge '+(result.severity==='HIGH'?'red':result.severity==='MODERATE'?'yellow':'green');
        document.getElementById('scanResult').style.display='block';
        saveHistory(result);
        document.getElementById('scanCount').textContent=getHistory().length;
        renderAdvisory();
        loader.style.display='none';analyze.disabled=false;
        toast('Scan completed — '+result.crop+' / '+result.detection);
      },500);
    };
  }

  /* Clear old hard-coded initial result text until a real scan is made. */
  const result=document.getElementById('scanResult');
  if(result && !(typeof latestScan!=='undefined' && latestScan)){
    result.style.display='none';
  }

  /* Re-render pest UI from only local user observations. */
  if(typeof renderPests==='function') renderPests();
})();

</script>


