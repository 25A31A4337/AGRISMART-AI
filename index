    if(fert){
      const names=[...fert.querySelectorAll('.fert-copy b')].map(x=>x.dataset.enText||x.textContent).filter(Boolean).slice(0,4);
      if(names.length)parts.push((l==='te'?'ఎరువులు: ':l==='hi'?'उर्वरक: ':'Fertilizers: ')+names.map(x=>translateScanValue(x,l)).join(', '));
    }
    return parts.join(' ');
  }
  function cleanTtsText(t){return String(t).replace(/[🌱📷🧠🔊⏹]/g,'').replace(/\s+/g,' ').trim();}
  function setSpeaking(on){document.querySelectorAll('.voice-floating').forEach(x=>x.classList.toggle('listening',!!on));}
  function pickNativeVoice(l){
    if(!('speechSynthesis' in window))return null;
    const voices=speechSynthesis.getVoices()||[];
    const wanted=l==='te'?['te-IN','te']:l==='hi'?['hi-IN','hi']:['en-IN','en-US','en-GB','en'];
    return voices.find(v=>wanted.some(x=>(v.lang||'').toLowerCase()===x.toLowerCase())) ||
           voices.find(v=>wanted.some(x=>(v.lang||'').toLowerCase().startsWith(x.split('-')[0].toLowerCase())));
  }
  function remoteSpeak(text,l){
    const q=encodeURIComponent(cleanTtsText(text).slice(0,1900));
    const tl=l==='te'?'te-IN':l==='hi'?'hi-IN':'en-IN';
    const urls=[
      'https://translate.google.com/translate_tts?ie=UTF-8&client=tw-ob&tl='+tl+'&q='+q,
      'https://translate.google.com/translate_tts?client=tw-ob&tl='+tl+'&q='+q
    ];
    let i=0;
    const tryAudio=()=>{
      if(i>=urls.length){setSpeaking(false);toastSafe(l==='te'?'తెలుగు వాయిస్ అందుబాటులో లేదు. పరికరం TTSలో Telugu voice install చేసి మళ్లీ Listen నొక్కండి.':l==='hi'?'हिंदी आवाज़ उपलब्ध नहीं है। डिवाइस के Text-to-Speech में Hindi voice install करके फिर Listen दबाएं.':'Voice playback failed. Tap Listen again.');return;}
      try{
        if(audio){audio.pause();audio.src='';}
        audio=new Audio(urls[i++]);audio.preload='auto';audio.volume=1;
        audio.onplay=()=>setSpeaking(true);audio.onended=()=>setSpeaking(false);audio.onerror=()=>tryAudio();
        const p=audio.play();if(p&&p.catch)p.catch(()=>tryAudio());
      }catch(e){tryAudio();}
    };
    tryAudio();
  }
  function nativeSpeak(text,l,voice){
    const ss=window.speechSynthesis;
    const clean=cleanTtsText(text);
    if(!clean)return;
    ss.cancel();
    try{ss.resume()}catch(e){}
    /* Start immediately. Do not wait for voiceschanged or a timer. The browser
       can synthesize directly from the requested Telugu/Hindi locale even when
       getVoices() has not populated yet. */
    const u=new SpeechSynthesisUtterance(clean);
    u.lang=voice?.lang||voiceLocale(l);
    if(voice)u.voice=voice;
    u.rate=.9;u.pitch=1;u.volume=1;
    let started=false;
    u.onstart=()=>{started=true;setSpeaking(true)};
    u.onend=()=>setSpeaking(false);
    u.onerror=()=>{
      setSpeaking(false);
      /* Only use network TTS if the native engine actually failed. */
      remoteSpeak(clean,l);
    };
    try{ss.speak(u)}catch(e){remoteSpeak(clean,l)}
    /* Some WebViews silently ignore speak() until resume; retry once without
       introducing the normal startup delay. */
    setTimeout(()=>{if(!started&&!ss.speaking){try{ss.resume();ss.speak(u)}catch(e){}}},0);
  }
  function speakNow(){
    const r=window.latestScan;
    if(!r){toastSafe(lang()==='te'?'ముందుగా పంటను స్కాన్ చేయండి.':lang()==='hi'?'पहले फसल स्कैन करें।':'Scan a crop first.');return;}
    const l=lang(),text=voiceText();if(!text)return;
    if(audio){try{audio.pause();audio.src=''}catch(e){}}
    if(!('speechSynthesis' in window)){remoteSpeak(text,l);return;}
    const ss=window.speechSynthesis;
    ss.cancel();ss.resume();
    /* Never wait for getVoices(): waiting causes the noticeable delay. Pass the
       locale immediately; an installed matching voice is used when available. */
    const v=pickNativeVoice(l);
    nativeSpeak(text,l,v);
  }
  function stopVoice(){
    try{if('speechSynthesis'in window){speechSynthesis.cancel();speechSynthesis.resume()}}catch(e){}
    try{if(audio){audio.pause();audio.currentTime=0}}catch(e){}
    setSpeaking(false);
  }
  function ensureVoiceUI(){
    const sr=$('scanResult');
    if(sr&&!sr.querySelector('.voice-assistant')){
      const d=document.createElement('div');d.className='voice-assistant';
      d.innerHTML='<button type="button" class="voice-btn" id="agrListenScan">🔊 Listen</button><button type="button" class="voice-btn stop" id="agrStopScan">⏹ Stop</button><span class="voice-help">Tap Listen to hear crop, problem, symptoms and advice.</span>';
      sr.appendChild(d);
    }
    const b=$('agrListenScan'),st=$('agrStopScan');
    if(b)b.onclick=speakNow;if(st)st.onclick=stopVoice;
    if(!$('agrVoiceFloating')){
      const f=document.createElement('button');f.id='agrVoiceFloating';f.className='voice-floating';f.textContent='🔊';f.setAttribute('aria-label','Voice Assistant');f.onclick=speakNow;document.body.appendChild(f);
    }
    const l=lang();
    if(b)b.textContent=l==='te'?'🔊 వినండి':l==='hi'?'🔊 सुनें':'🔊 Listen';
    if(st)st.textContent=l==='te'?'⏹ ఆపండి':l==='hi'?'⏹ रोकें':'⏹ Stop';
    const h=sr?.querySelector('.voice-help');
    if(h)h.textContent=l==='te'?'పంట, సమస్య, లక్షణాలు మరియు సూచనలు వినడానికి నొక్కండి.':l==='hi'?'फसल, समस्या, लक्षण और सलाह सुनने के लिए दबाएं.':'Tap Listen to hear crop, problem, symptoms and advice.';
  }
  window.agrSpeakScan=speakNow;window.agrStopVoice=stopVoice;
  if('speechSynthesis' in window){speechSynthesis.onvoiceschanged=()=>{try{speechSynthesis.getVoices()}catch(e){}};speechSynthesis.getVoices();}
  ensureVoiceUI();
  const scanResult=$('scanResult');
  if(scanResult)new MutationObserver(()=>setTimeout(ensureVoiceUI,30)).observe(scanResult,{childList:true,subtree:true});
  setTimeout(()=>{ensureVoiceUI();fullScanTranslate(lang())},100);

})();
</script>
