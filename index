/* =========================================================
HISTORY
========================================================= */

function getHistory(){

return JSON.parse(
localStorage.getItem(
"agrishieldHistory"
)||"[]"
);

}


function saveHistory(result){

const history=
getHistory();


history.unshift({

id:Date.now(),

date:new Date()
.toLocaleString("en-IN"),

crop:result.crop,

detection:result.detection,

confidence:result.confidence,

severity:result.severity

});


localStorage.setItem(
"agrishieldHistory",
JSON.stringify(history)
);

}


function renderHistory(){

const history=
getHistory();

const body=
$("historyBody");

const empty=
$("emptyHistory");

const chart=
$("healthChart");

const labels=
$("chartLabels");


body.innerHTML="";
chart.innerHTML="";
labels.innerHTML="";


if(!history.length){

empty.style.display="block";

labels.textContent="No scans yet";

return;

}


empty.style.display="none";


history.forEach(item=>{

let cls="green";

if(item.severity==="HIGH"){
cls="red";
}
else if(item.severity==="MODERATE"){
cls="yellow";
}


const row=
document.createElement("tr");


row.innerHTML=`

<td>${item.date}</td>
<td>${item.crop}</td>
<td>${item.detection}</td>
<td>${item.confidence}</td>
<td>
<span class="badge ${cls}">
${item.severity}
</span>
</td>

`;


body.appendChild(row);

});


/* Graph */

const recent=
history.slice(0,8).reverse();

const points=[];

const width=680;
const height=160;


recent.forEach((item,i)=>{

let health=90;

if(item.severity==="HIGH")
health=45;

if(item.severity==="MODERATE")
health=68;


const x=
recent.length===1
?
width/2
:
20+i*(width-40)/(recent.length-1);


const y=
height-(health/100*height);


points.push({x,y});

});


if(points.length){

const line=
document.createElementNS(
"http://www.w3.org/2000/svg",
"polyline"
);

line.setAttribute(
"points",
points.map(
p=>`${p.x},${p.y}`
).join(" ")
);

line.setAttribute(
"class",
"line"
);

chart.appendChild(line);


points.forEach(p=>{

const circle=
document.createElementNS(
"http://www.w3.org/2000/svg",
"circle"
);

circle.setAttribute("cx",p.x);
circle.setAttribute("cy",p.y);
circle.setAttribute("r","5");
circle.setAttribute(
"class",
"line-point"
);

chart.appendChild(circle);

});


recent.forEach(item=>{

const span=
document.createElement("span");

span.textContent=
item.date.split(",")[0];

labels.appendChild(span);

});

}

}


