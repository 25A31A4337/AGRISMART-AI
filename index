<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AgriShield | Smart Crop Protection</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:"Segoe UI",Arial,sans-serif;
}

body{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    padding:20px;
    overflow:hidden;

    background:
        linear-gradient(
            -45deg,
            #e8f5e9,
            #f1f8e9,
            #dcedc8,
            #e0f2f1
        );

    background-size:400% 400%;
    animation:bgMove 12s ease infinite;
}

/* BACKGROUND */

.bg{
    position:fixed;
    border-radius:50%;
    pointer-events:none;
    z-index:-1;
}

.bg1{
    width:350px;
    height:350px;
    left:-130px;
    top:-120px;
    background:rgba(76,175,80,.13);
    animation:float1 8s ease-in-out infinite;
}

.bg2{
    width:420px;
    height:420px;
    right:-150px;
    bottom:-170px;
    background:rgba(139,195,74,.14);
    animation:float2 10s ease-in-out infinite;
}

.bg3{
    width:170px;
    height:170px;
    right:12%;
    top:30%;
    background:rgba(46,125,50,.08);
    animation:float3 7s ease-in-out infinite;
}

/* AUTH */

.auth-container{
    width:100%;
    max-width:450px;
    animation:pageIn .8s ease;
}

.logo-area{
    text-align:center;
    margin-bottom:22px;
}

.logo{
    width:82px;
    height:82px;
    margin:auto;

    display:flex;
    justify-content:center;
    align-items:center;

    border-radius:50%;

    background:
        linear-gradient(
            135deg,
            #1b5e20,
            #43a047
        );

    font-size:42px;

    box-shadow:
        0 12px 30px rgba(46,125,50,.25);

    animation:
        logoFloat 3s ease-in-out infinite,
        logoGlow 2.5s infinite;
}

.logo-area h1{
    color:#1b5e20;
    font-size:31px;
    margin-top:12px;
    animation:textUp .7s ease .2s both;
}

.logo-area p{
    color:#657065;
    font-size:14px;
    margin-top:5px;
    animation:textUp .7s ease .4s both;
}

/* CARD */

.auth-card{
    background:rgba(255,255,255,.96);
    border-radius:25px;
    padding:32px;

    border:1px solid rgba(255,255,255,.8);

    box-shadow:
        0 25px 65px rgba(0,0,0,.12),
        0 5px 18px rgba(46,125,50,.08);

    backdrop-filter:blur(15px);

    animation:cardIn .8s cubic-bezier(.17,.67,.3,1.2);
}

.auth-card h2{
    text-align:center;
    color:#1b5e20;
    font-size:25px;
    margin-bottom:7px;
}

.subtitle{
    text-align:center;
    color:#777;
    font-size:14px;
    margin-bottom:25px;
}

/* FORM */

.form-group{
    margin-bottom:17px;
    animation:fieldIn .55s ease both;
}

.form-group label{
    display:block;
    font-size:14px;
    font-weight:600;
    color:#333;
    margin-bottom:7px;
}

.input-wrapper{
    position:relative;
}

.input-icon{
    position:absolute;
    left:14px;
    top:50%;
    transform:translateY(-50%);
    font-size:17px;
    z-index:2;
}

.form-input{
    width:100%;
    padding:14px 14px 14px 43px;

    border:1px solid #d8ded8;
    border-radius:11px;

    outline:none;
    font-size:15px;

    background:white;

    transition:
        .3s;
}

.form-input:hover{
    border-color:#81c784;
}

.form-input:focus{
    border-color:#43a047;

    box-shadow:
        0 0 0 4px rgba(67,160,71,.11),
        0 5px 15px rgba(67,160,71,.07);

    transform:translateY(-1px);
}

.password-wrapper .form-input{
    padding-right:48px;
}

.show-password{
    position:absolute;
    right:12px;
    top:50%;
    transform:translateY(-50%);

    border:none;
    background:none;

    cursor:pointer;
    font-size:18px;
}

/* BUTTON */

.main-btn{
    width:100%;
    padding:14px;

    border:none;
    border-radius:11px;

    background:
        linear-gradient(
            135deg,
            #1b5e20,
            #43a047
        );

    color:white;

    font-size:16px;
    font-weight:700;

    cursor:pointer;

    position:relative;
    overflow:hidden;

    transition:.3s;
}

.main-btn:hover{
    transform:translateY(-3px);
    box-shadow:0 10px 25px rgba(46,125,50,.3);
}

.main-btn:active{
    transform:scale(.97);
}

.main-btn::before{
    content:"";

    position:absolute;
    top:0;
    left:-120%;

    width:100%;
    height:100%;

    background:rgba(255,255,255,.3);

    transform:skewX(-20deg);
}

.main-btn:hover::before{
    animation:shine .7s ease;
}

/* SWITCH */

.switch-text{
    text-align:center;
    margin-top:20px;
    color:#777;
    font-size:14px;
}

.switch-btn{
    border:none;
    background:none;

    color:#2e7d32;
    font-weight:700;

    cursor:pointer;
    font-size:14px;

    position:relative;
}

.switch-btn::after{
    content:"";

    position:absolute;
    bottom:-3px;
    left:0;

    width:0;
    height:2px;

    background:#2e7d32;

    transition:.3s;
}

.switch-btn:hover::after{
    width:100%;
}

.security{
    margin-top:20px;
    padding:12px;

    border-radius:10px;

    background:#f3f8f3;
    border:1px solid #e0ebe0;

    text-align:center;

    color:#657065;
    font-size:12px;
}

/* MESSAGE */

.message{
    display:none;

    padding:11px;
    margin-bottom:16px;

    border-radius:9px;

    text-align:center;
    font-size:13px;

    animation:messageIn .4s ease;
}

.message.error{
    background:#ffebee;
    color:#c62828;
}

.message.success{
    background:#e8f5e9;
    color:#2e7d32;
}

/* =====================================================
   LOGIN SUCCESS SCREEN
===================================================== */

#loginTransition{
    display:none;

    position:fixed;
    inset:0;

    z-index:99999;

    justify-content:center;
    align-items:center;

    background:
        radial-gradient(
            circle,
            #f1f8e9,
            #c8e6c9,
            #81c784
        );

    perspective:1400px;
}

.transition-content{
    text-align:center;
    transform-style:preserve-3d;

    animation:
        transitionAppear
        1.1s
        cubic-bezier(.2,.8,.2,1);
}

.transition-logo{
    width:120px;
    height:120px;

    margin:auto;

    border-radius:50%;

    display:flex;
    align-items:center;
    justify-content:center;

    background:
        linear-gradient(
            135deg,
            #1b5e20,
            #43a047
        );

    font-size:58px;

    box-shadow:
        0 20px 50px rgba(27,94,32,.3);

    animation:
        logo360
        1.6s
        cubic-bezier(.2,.8,.2,1);
}

.transition-content h2{
    margin-top:24px;

    color:#1b5e20;
    font-size:28px;

    animation:
        transitionText
        .8s
        ease
        .3s
        both;
}

.transition-content p{
    margin-top:8px;

    color:#476447;

    animation:
        transitionText
        .8s
        ease
        .5s
        both;
}

/* =====================================================
   DASHBOARD
===================================================== */

#dashboard{
    display:none;

    position:fixed;
    inset:0;

    overflow-y:auto;

    background:
        radial-gradient(
            circle at 10% 10%,
            rgba(76,175,80,.12),
            transparent 30%
        ),
        radial-gradient(
            circle at 90% 90%,
            rgba(139,195,74,.12),
            transparent 30%
        ),
        #f5f8f5;

    perspective:1400px;

    animation:
        dashboardEntrance
        1.2s
        cubic-bezier(.2,.8,.2,1);
}

/* HEADER */

.dashboard-header{
    height:70px;

    padding:0 30px;

    display:flex;
    align-items:center;
    justify-content:space-between;

    color:white;

    background:
        linear-gradient(
            135deg,
            #1b5e20,
            #2e7d32,
            #43a047
        );

    background-size:200% 200%;

    box-shadow:
        0 5px 20px rgba(0,0,0,.15);

    animation:
        headerSlide .8s ease .35s both,
        headerGradient 6s ease infinite;
}

.dashboard-logo{
    font-size:22px;
    font-weight:700;

    animation:
        dashboardLogo .9s ease .5s both;
}

.logout-btn{
    border:1px solid rgba(255,255,255,.7);

    background:rgba(255,255,255,.08);

    color:white;

    border-radius:9px;

    padding:9px 16px;

    cursor:pointer;

    transition:.3s;
}

.logout-btn:hover{
    background:white;
    color:#2e7d32;

    transform:
        translateY(-3px)
        rotate(-2deg);
}

/* CONTENT */

.dashboard-content{
    max-width:1050px;

    margin:auto;

    padding:30px 20px 60px;

    perspective:1200px;
}

/* WELCOME */

.welcome-card{
    background:rgba(255,255,255,.97);

    border-radius:22px;

    padding:30px;

    margin-bottom:24px;

    box-shadow:
        0 10px 30px rgba(0,0,0,.07);

    transform-style:preserve-3d;

    animation:
        welcomeFlip
        1s
        cubic-bezier(.2,.8,.2,1)
        .55s both;

    transition:.4s;
}

.welcome-card:hover{
    transform:
        translateY(-5px)
        rotateX(2deg)
        rotateY(-2deg);

    box-shadow:
        0 18px 40px rgba(0,0,0,.10);
}

.welcome-card h1{
    color:#1b5e20;
    margin-bottom:8px;

    animation:
        welcomeText
        .7s
        ease
        1s
        both;
}

.welcome-card p{
    color:#777;

    animation:
        welcomeText
        .7s
        ease
        1.1s
        both;
}

/* FEATURES */

.features{
    display:grid;

    grid-template-columns:
        repeat(
            auto-fit,
            minmax(220px,1fr)
        );

    gap:20px;

    perspective:1200px;
}

.feature-card{
    background:white;

    border-radius:18px;

    padding:25px;

    box-shadow:
        0 7px 22px rgba(0,0,0,.06);

    transform-style:preserve-3d;

    opacity:0;

    animation:
        featureFlip
        .9s
        cubic-bezier(.2,.8,.2,1)
        forwards;

    transition:
        transform .45s,
        box-shadow .45s;
}

.feature-card:nth-child(1){
    animation-delay:.75s;
}

.feature-card:nth-child(2){
    animation-delay:.9s;
}

.feature-card:nth-child(3){
    animation-delay:1.05s;
}

.feature-card:nth-child(4){
    animation-delay:1.2s;
}

.feature-card:nth-child(5){
    animation-delay:1.35s;
}

.feature-card:nth-child(6){
    animation-delay:1.5s;
}

.feature-card:hover{
    transform:
        translateY(-12px)
        rotateX(5deg)
        rotateY(-5deg)
        scale(1.025);

    box-shadow:
        0 20px 40px rgba(46,125,50,.13);
}

.feature-icon{
    display:inline-block;

    font-size:36px;

    margin-bottom:14px;

    transform:translateZ(30px);

    animation:
        iconFloat
        3s
        ease-in-out
        infinite;

    transition:.4s;
}

.feature-card:hover .feature-icon{
    transform:
        translateZ(50px)
        scale(1.25)
        rotateY(180deg);
}

.feature-card h3{
    color:#2e7d32;
    margin-bottom:8px;

    transform:translateZ(20px);
}

.feature-card p{
    color:#777;
    font-size:14px;
    line-height:1.55;
}

/* =====================================================
   ANIMATIONS
===================================================== */

@keyframes bgMove{
    0%{background-position:0% 50%}
    50%{background-position:100% 50%}
    100%{background-position:0% 50%}
}

@keyframes pageIn{
    from{
        opacity:0;
        transform:scale(.94);
    }
    to{
        opacity:1;
        transform:scale(1);
    }
}

@keyframes cardIn{
    from{
        opacity:0;
        transform:
            translateY(45px)
            rotateX(12deg)
            scale(.94);
    }
    to{
        opacity:1;
        transform:
            translateY(0)
            rotateX(0)
            scale(1);
    }
}

@keyframes logoFloat{
    0%,100%{
        transform:translateY(0);
    }
    50%{
        transform:translateY(-9px);
    }
}

@keyframes logoGlow{
    0%{
        box-shadow:
            0 12px 30px rgba(46,125,50,.25),
            0 0 0 0 rgba(76,175,80,.4);
    }
    50%{
        box-shadow:
            0 12px 30px rgba(46,125,50,.25),
            0 0 0 14px rgba(76,175,80,0);
    }
    100%{
        box-shadow:
            0 12px 30px rgba(46,125,50,.25),
            0 0 0 0 rgba(76,175,80,0);
    }
}

@keyframes textUp{
    from{
        opacity:0;
        transform:translateY(12px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

@keyframes fieldIn{
    from{
        opacity:0;
        transform:translateX(-15px);
    }
    to{
        opacity:1;
        transform:translateX(0);
    }
}

@keyframes messageIn{
    from{
        opacity:0;
        transform:scale(.9) translateY(-5px);
    }
    to{
        opacity:1;
        transform:scale(1) translateY(0);
    }
}

@keyframes shine{
    from{
        left:-120%;
    }
    to{
        left:130%;
    }
}

/* LOGIN TRANSITION */

@keyframes transitionAppear{
    0%{
        opacity:0;

        transform:
            scale(.6)
            rotateX(25deg);
    }

    100%{
        opacity:1;

        transform:
            scale(1)
            rotateX(0);
    }
}

@keyframes logo360{
    0%{
        opacity:0;

        transform:
            perspective(800px)
            rotateY(0)
            rotateX(20deg)
            scale(.2);
    }

    35%{
        opacity:1;

        transform:
            perspective(800px)
            rotateY(180deg)
            rotateX(-15deg)
            scale(1.15);
    }

    70%{
        transform:
            perspective(800px)
            rotateY(360deg)
            rotateX(10deg)
            scale(.95);
    }

    100%{
        opacity:1;

        transform:
            perspective(800px)
            rotateY(720deg)
            rotateX(0)
            scale(1);
    }
}

@keyframes transitionText{
    from{
        opacity:0;
        transform:translateY(20px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }
}

/* DASHBOARD */

@keyframes dashboardEntrance{
    0%{
        opacity:0;

        transform:
            perspective(1400px)
            rotateY(-90deg)
            rotateX(10deg)
            scale(.8);

        transform-origin:left center;
    }

    55%{
        opacity:1;

        transform:
            perspective(1400px)
            rotateY(12deg)
            rotateX(-3deg)
            scale(1.02);
    }

    100%{
        opacity:1;

        transform:
            perspective(1400px)
            rotateY(0)
            rotateX(0)
            scale(1);
    }
}

@keyframes headerSlide{
    from{
        opacity:0;
        transform:translateY(-70px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

@keyframes headerGradient{
    0%{background-position:0% 50%}
    50%{background-position:100% 50%}
    100%{background-position:0% 50%}
}

@keyframes dashboardLogo{
    from{
        opacity:0;
        transform:
            rotateY(-180deg)
            scale(.4);
    }
    to{
        opacity:1;
        transform:
            rotateY(0)
            scale(1);
    }
}

@keyframes welcomeFlip{
    0%{
        opacity:0;

        transform:
            perspective(1000px)
            rotateX(-70deg)
            translateY(50px)
            scale(.9);
    }

    70%{
        opacity:1;

        transform:
            perspective(1000px)
            rotateX(8deg)
            translateY(-4px)
            scale(1.01);
    }

    100%{
        opacity:1;

        transform:
            perspective(1000px)
            rotateX(0)
            translateY(0)
            scale(1);
    }
}

@keyframes welcomeText{
    from{
        opacity:0;
        transform:translateY(15px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

@keyframes featureFlip{
    0%{
        opacity:0;

        transform:
            perspective(900px)
            rotateY(80deg)
            rotateX(20deg)
            translateY(35px)
            scale(.8);
    }

    65%{
        opacity:1;

        transform:
            perspective(900px)
            rotateY(-8deg)
            rotateX(-2deg)
            translateY(-3px)
            scale(1.02);
    }

    100%{
        opacity:1;

        transform:
            perspective(900px)
            rotateY(0)
            rotateX(0)
            translateY(0)
            scale(1);
    }
}

@keyframes iconFloat{
    0%,100%{
        transform:
            translateY(0)
            rotate(0);
    }

    50%{
        transform:
            translateY(-6px)
            rotate(3deg);
    }
}

@keyframes float1{
    0%,100%{
        transform:translate(0,0);
    }

    50%{
        transform:translate(70px,50px);
    }
}

@keyframes float2{
    0%,100%{
        transform:translate(0,0);
    }

    50%{
        transform:translate(-60px,-50px);
    }
}

@keyframes float3{
    0%,100%{
        transform:translate(0,0);
    }

    50%{
        transform:translate(-30px,40px);
    }
}

/* MOBILE */

@media(max-width:600px){

    body{
        padding:15px;
        overflow-y:auto;
    }

    .auth-card{
        padding:25px 20px;
    }

    .logo{
        width:70px;
        height:70px;
        font-size:34px;
    }

    .logo-area h1{
        font-size:27px;
    }

    .dashboard-header{
        padding:0 15px;
    }

    .dashboard-logo{
        font-size:19px;
    }

    .dashboard-content{
        padding:20px 15px 40px;
    }

    .features{
        grid-template-columns:1fr;
    }

    .feature-card:hover{
        transform:
            translateY(-7px)
            scale(1.01);
    }
}
</style>
</head>

<body>

<!-- BACKGROUND -->

<div class="bg bg1"></div>
<div class="bg bg2"></div>
<div class="bg bg3"></div>


<!-- =====================================================
     AUTHENTICATION
===================================================== -->

<div
    class="auth-container"
    id="authContainer">

    <!-- LOGO -->

    <div class="logo-area">

        <div class="logo">
            🌾
        </div>

        <h1>
            AgriShield
        </h1>

        <p>
            Smart Crop Protection
        </p>

    </div>


    <div class="auth-card">


        <!-- =================================================
             LOGIN
        ================================================= -->

        <div id="loginPage">

            <h2>
                Welcome Back 👋
            </h2>

            <p class="subtitle">
                Login to your AgriShield account
            </p>


            <div
                id="loginMessage"
                class="message">
            </div>


            <!-- MOBILE -->

            <div class="form-group">

                <label>
                    Mobile Number
                </label>

                <div class="input-wrapper">

                    <span class="input-icon">
                        📱
                    </span>

                    <input
                        id="loginMobile"
                        class="form-input"
                        type="tel"
                        maxlength="10"
                        inputmode="numeric"
                        placeholder="Enter registered mobile number"
                    >

                </div>

            </div>


            <!-- PASSWORD -->

            <div class="form-group">

                <label>
                    Password
                </label>

                <div class="input-wrapper password-wrapper">

                    <span class="input-icon">
                        🔒
                    </span>

                    <input
                        id="loginPassword"
                        class="form-input"
                        type="password"
                        placeholder="Enter your password"
                    >

                    <button
                        class="show-password"
                        type="button"
                        onclick="togglePassword('loginPassword',this)">
                        👁️
                    </button>

                </div>

            </div>


            <button
                class="main-btn"
                onclick="login()">

                Login to AgriShield

            </button>


            <div class="switch-text">

                Don't have an account?

                <button
                    class="switch-btn"
                    onclick="showCreateAccount()">

                    Create Account

                </button>

            </div>


            <div class="security">

                🔐 Only registered AgriShield users
                can access the dashboard.

            </div>

        </div>


        <!-- =================================================
             CREATE ACCOUNT
        ================================================= -->

        <div
            id="createPage"
            style="display:none;">

            <h2>
                🌱 Create Account
            </h2>

            <p class="subtitle">
                Create your AgriShield farmer account
            </p>


            <div
                id="createMessage"
                class="message">
            </div>


            <!-- NAME -->

            <div class="form-group">

                <label>
                    Full Name
                </label>

                <div class="input-wrapper">

                    <span class="input-icon">
                        👤
                    </span>

                    <input
                        id="createName"
                        class="form-input"
                        type="text"
                        placeholder="Enter your full name"
                    >

                </div>

            </div>


            <!-- MOBILE -->

            <div class="form-group">

                <label>
                    Mobile Number
                </label>

                <div class="input-wrapper">

                    <span class="input-icon">
                        📱
                    </span>

                    <input
                        id="createMobile"
                        class="form-input"
                        type="tel"
                        maxlength="10"
                        inputmode="numeric"
                        placeholder="Enter 10-digit mobile number"
                    >

                </div>

            </div>


            <!-- PASSWORD -->

            <div class="form-group">

                <label>
                    Create Password
                </label>

                <div class="input-wrapper password-wrapper">

                    <span class="input-icon">
                        🔒
                    </span>

                    <input
                        id="createPassword"
                        class="form-input"
                        type="password"
                        placeholder="Create password"
                    >

                    <button
                        class="show-password"
                        type="button"
                        onclick="togglePassword('createPassword',this)">
                        👁️
                    </button>

                </div>

                <div class="password-note">
                    Minimum 6 characters
                </div>

            </div>


            <!-- CONFIRM -->

            <div class="form-group">

                <label>
                    Confirm Password
                </label>

                <div class="input-wrapper password-wrapper">

                    <span class="input-icon">
                        🔐
                    </span>

                    <input
                        id="confirmPassword"
                        class="form-input"
                        type="password"
                        placeholder="Confirm password"
                    >

                    <button
                        class="show-password"
                        type="button"
                        onclick="togglePassword('confirmPassword',this)">
                        👁️
                    </button>

                </div>

            </div>


            <button
                class="main-btn"
                onclick="createAccount()">

                Create My Account

            </button>


            <div class="switch-text">

                Already have an account?

                <button
                    class="switch-btn"
                    onclick="showLogin()">

                    Login

                </button>

            </div>


            <div class="security">

                🌾 Your registered account is required
                to access AgriShield.

            </div>

        </div>

    </div>

</div>


<!-- =====================================================
     LOGIN SUCCESS ANIMATION
===================================================== -->

<div id="loginTransition">

    <div class="transition-content">

        <div class="transition-logo">
            🌾
        </div>

        <h2>
            Welcome to AgriShield
        </h2>

        <p>
            Preparing your smart farming dashboard...
        </p>

    </div>

</div>


<!-- =====================================================
     DASHBOARD
===================================================== -->

<div id="dashboard">

    <header class="dashboard-header">

        <div class="dashboard-logo">
            🌾 AgriShield
        </div>

        <button
            class="logout-btn"
            onclick="logout()">

            Logout

        </button>

    </header>


    <main class="dashboard-content">


        <div class="welcome-card">

            <h1 id="welcomeName">
                Welcome!
            </h1>

            <p>
                Your AgriShield account is active.
                Protect your crops with smart technology.
            </p>

        </div>


        <div class="features">


            <div class="feature-card">

                <div class="feature-icon">
                    📷
                </div>

                <h3>
                    Crop Scan
                </h3>

                <p>
                    Scan crop leaves and identify
                    possible diseases using AI.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    🌦️
                </div>

                <h3>
                    Weather
                </h3>

                <p>
                    Monitor current weather conditions
                    affecting your crops.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    🐛
                </div>

                <h3>
                    Pest Monitoring
                </h3>

                <p>
                    Monitor pest risks and protect
                    your crops at the right time.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    💧
                </div>

                <h3>
                    Water Stress
                </h3>

                <p>
                    Monitor crop water requirements
                    and irrigation conditions.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    🤖
                </div>

                <h3>
                    AI Advisory
                </h3>

                <p>
                    Get intelligent recommendations
                    for healthier crops.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    📋
                </div>

                <h3>
                    Scan History
                </h3>

                <p>
                    View previous crop scans and
                    crop health observations.
                </p>

            </div>


        </div>

    </main>

</div>


<script>

/* =====================================================
   ACCOUNT STORAGE
===================================================== */

function getAccounts(){

    const saved =
        localStorage.getItem("agriAccounts");

    if(!saved){
        return [];
    }

    try{
        return JSON.parse(saved);
    }
    catch(error){
        return [];
    }
}


function saveAccounts(accounts){

    localStorage.setItem(
        "agriAccounts",
        JSON.stringify(accounts)
    );

}


/* =====================================================
   SHOW LOGIN
===================================================== */

function showLogin(){

    document.getElementById(
        "loginPage"
    ).style.display = "block";

    document.getElementById(
        "createPage"
    ).style.display = "none";

    clearMessages();

}


/* =====================================================
   SHOW CREATE ACCOUNT
===================================================== */

function showCreateAccount(){

    document.getElementById(
        "loginPage"
    ).style.display = "none";

    document.getElementById(
        "createPage"
    ).style.display = "block";

    clearMessages();

}


/* =====================================================
   CREATE ACCOUNT
===================================================== */

function createAccount(){

    const name =
        document.getElementById(
            "createName"
        ).value.trim();

    const mobile =
        document.getElementById(
            "createMobile"
        ).value.trim();

    const password =
        document.getElementById(
            "createPassword"
        ).value;

    const confirmPassword =
        document.getElementById(
            "confirmPassword"
        ).value;


    if(name.length < 2){

        showMessage(
            "createMessage",
            "Please enter your full name.",
            "error"
        );

        return;
    }


    if(!/^[0-9]{10}$/.test(mobile)){

        showMessage(
            "createMessage",
            "Enter a valid 10-digit mobile number.",
            "error"
        );

        return;
    }


    if(password.length < 6){

        showMessage(
            "createMessage",
            "Password must contain at least 6 characters.",
            "error"
        );

        return;
    }


    if(password !== confirmPassword){

        showMessage(
            "createMessage",
            "Passwords do not match.",
            "error"
        );

        return;
    }


    const accounts = getAccounts();


    const existing =
        accounts.find(
            account =>
                account.mobile === mobile
        );


    if(existing){

        showMessage(
            "createMessage",
            "This mobile number is already registered. Please login.",
            "error"
        );

        return;
    }


    accounts.push({

        name:name,

        mobile:mobile,

        password:password,

        createdAt:
            new Date().toISOString()

    });


    saveAccounts(accounts);


    showMessage(
        "createMessage",
        "Account created successfully! Opening login...",
        "success"
    );


    document.getElementById(
        "createName"
    ).value = "";

    document.getElementById(
        "createMobile"
    ).value = "";

    document.getElementById(
        "createPassword"
    ).value = "";

    document.getElementById(
        "confirmPassword"
    ).value = "";


    setTimeout(function(){

        showLogin();

        document.getElementById(
            "loginMobile"
        ).value = mobile;

    },1200);

}


/* =====================================================
   LOGIN
===================================================== */

function login(){

    const mobile =
        document.getElementById(
            "loginMobile"
        ).value.trim();

    const password =
        document.getElementById(
            "loginPassword"
        ).value;


    if(!/^[0-9]{10}$/.test(mobile)){

        showMessage(
            "loginMessage",
            "Enter your registered 10-digit mobile number.",
            "error"
        );

        return;
    }


    if(!password){

        showMessage(
            "loginMessage",
            "Please enter your password.",
            "error"
        );

        return;
    }


    const accounts =
        getAccounts();


    const account =
        accounts.find(
            user =>
                user.mobile === mobile
        );


    if(!account){

        showMessage(
            "loginMessage",
            "Account not found. Please create an account first.",
            "error"
        );

        return;
    }


    if(account.password !== password){

        showMessage(
            "loginMessage",
            "Incorrect password. Access denied.",
            "error"
        );

        return;
    }


    /* SUCCESS */

    localStorage.setItem(
        "agriLoggedIn",
        "true"
    );


    localStorage.setItem(
        "agriCurrentUser",
        JSON.stringify({

            name:account.name,

            mobile:account.mobile

        })
    );


    /* START 3D TRANSITION */

    showLoginSuccessAnimation();

}


/* =====================================================
   SUCCESS ANIMATION
===================================================== */

function showLoginSuccessAnimation(){

    const auth =
        document.getElementById(
            "authContainer"
        );

    const transition =
        document.getElementById(
            "loginTransition"
        );


    transition.style.display = "flex";


    auth.style.transition =
        "transform .8s ease, opacity .8s ease";


    auth.style.transform =
        "perspective(1200px) rotateY(90deg) scale(.8)";

    auth.style.opacity = "0";


    setTimeout(function(){

        transition.style.opacity = "0";

        transition.style.transition =
            "opacity .5s ease";

    },1500);


    setTimeout(function(){

        transition.style.display = "none";

        transition.style.opacity = "1";

        transition.style.transition = "";

        auth.style.display = "none";

        auth.style.transform = "";

        auth.style.opacity = "";

        openDashboard();

    },2000);

}


/* =====================================================
   OPEN DASHBOARD
===================================================== */

function openDashboard(){

    const currentUser =
        localStorage.getItem(
            "agriCurrentUser"
        );


    if(!currentUser){

        return;

    }


    let user;


    try{

        user =
            JSON.parse(currentUser);

    }
    catch(error){

        logout();

        return;

    }


    const accounts =
        getAccounts();


    const validAccount =
        accounts.find(
            account =>
                account.mobile === user.mobile &&
                account.name === user.name
        );


    if(!validAccount){

        logout();

        return;

    }


    document.getElementById(
        "authContainer"
    ).style.display = "none";


    const dashboard =
        document.getElementById(
            "dashboard"
        );


    dashboard.style.display = "block";


    /* Restart dashboard animation */

    dashboard.style.animation = "none";

    void dashboard.offsetWidth;

    dashboard.style.animation =
        "dashboardEntrance 1.2s cubic-bezier(.2,.8,.2,1)";


    document.getElementById(
        "welcomeName"
    ).textContent =
        "Welcome, " +
        user.name +
        "! 👋";

}


/* =====================================================
   LOGOUT
===================================================== */

function logout(){

    localStorage.removeItem(
        "agriLoggedIn"
    );

    localStorage.removeItem(
        "agriCurrentUser"
    );


    document.getElementById(
        "dashboard"
    ).style.display = "none";


    const auth =
        document.getElementById(
            "authContainer"
        );


    auth.style.display = "block";

    auth.style.opacity = "1";

    auth.style.transform = "";

    auth.style.transition = "";


    document.getElementById(
        "loginMobile"
    ).value = "";

    document.getElementById(
        "loginPassword"
    ).value = "";


    showLogin();

}


/* =====================================================
   CHECK LOGIN
===================================================== */

function checkLogin(){

    const loggedIn =
        localStorage.getItem(
            "agriLoggedIn"
        );

    const currentUser =
        localStorage.getItem(
            "agriCurrentUser"
        );


    if(
        loggedIn === "true" &&
        currentUser
    ){

        openDashboard();

    }
    else{

        document.getElementById(
            "dashboard"
        ).style.display = "none";

        document.getElementById(
            "authContainer"
        ).style.display = "block";

    }

}


/* =====================================================
   PASSWORD SHOW/HIDE
===================================================== */

function togglePassword(
    inputId,
    button
){

    const input =
        document.getElementById(
            inputId
        );


    if(input.type === "password"){

        input.type = "text";

        button.textContent = "🙈";

    }
    else{

        input.type = "password";

        button.textContent = "👁️";

    }

}


/* =====================================================
   MESSAGE
===================================================== */

function showMessage(
    id,
    text,
    type
){

    const element =
        document.getElementById(id);


    element.textContent = text;

    element.className =
        "message " + type;

    element.style.display = "block";


    element.style.animation = "none";

    void element.offsetWidth;

    element.style.animation =
        "messageIn .4s ease";

}


/* =====================================================
   CLEAR MESSAGES
===================================================== */

function clearMessages(){

    document.getElementById(
        "loginMessage"
    ).style.display = "none";


    document.getElementById(
        "createMessage"
    ).style.display = "none";

}


/* =====================================================
   ENTER KEY
===================================================== */

document.addEventListener(
    "keydown",
    function(event){

        if(event.key !== "Enter"){
            return;
        }


        const loginPage =
            document.getElementById(
                "loginPage"
            );


        if(
            loginPage.style.display !== "none"
        ){

            login();

        }
        else{

            createAccount();

        }

    }
);


/* =====================================================
   START
===================================================== */

window.addEventListener(
    "load",
    function(){

        checkLogin();

    }
);

</script>

</body>
</html>
