<script>
(function(){
  const $=id=>document.getElementById(id);
  const read=(k,d)=>{try{return JSON.parse(localStorage.getItem(k)||JSON.stringify(d))||d}catch(e){return d}};

    

  /* Persist the latest scan so the dashboard/advisory can use it after navigation. */
  window.__persistScan=function(r){
    try{localStorage.setItem('agrishieldLatestScan',JSON.stringify(r))}catch(e){}
  };

  function inferFromFilename(name){
    const n=(name||'').toLowerCase().replace(/[_-]+/g,' ');
    const crops=['Tomato','Potato','Chilli','Cotton','Rice','Wheat','Brinjal','Eggplant','Okra','Ladyfinger','Groundnut','Peanut','Maize','Corn','Soybean','Sugarcane','Onion','Cabbage','Cauliflower','Banana','Mango','Grape'];
    let crop=crops.find(x=>n.includes(x.toLowerCase()));
    if(crop==='Eggplant')crop='Brinjal'; if(crop==='Ladyfinger')crop='Okra'; if(crop==='Peanut')crop='Groundnut'; if(crop==='Corn')crop='Maize';
    const diseaseKeys=[
      ['early blight','Early Blight'],['late blight','Late Blight'],['leaf blast','Leaf Blast'],['blast','Leaf Blast'],['rust','Rust'],['powdery mildew','Powdery Mildew'],['downy mildew','Downy Mildew'],['leaf spot','Leaf Spot'],['spot','Leaf Spot'],['wilt','Wilt'],['mosaic','Mosaic Virus'],['yellow vein','Yellow Vein Mosaic'],['bacterial blight','Bacterial Blight'],['anthracnose','Anthracnose'],['root rot','Root Rot'],['damping off','Damping Off'],['stem rot','Stem Rot'],['fruit rot','Fruit Rot'],['dieback','Dieback'],['canker','Canker'],['scab','Scab'],['smut','Smut'],['shoot borer','Shoot Borer'],['fruit borer','Fruit Borer'],['stem borer','Stem Borer'],['bollworm','Bollworm'],['armyworm','Fall Armyworm'],['whitefly','Whitefly Damage'],['thrips','Thrips Damage'],['aphid','Aphid Damage'],['jassid','Jassid Damage'],['leaf miner','Leaf Miner Damage']
    ];
    const hit=diseaseKeys.find(x=>n.includes(x[0]));
    return {crop:crop||'Crop image',disease:hit?hit[1]:'Image ready for analysis'};
  }

  const info={
    'Early Blight':['94%','Dark circular leaf spots and yellowing.','Remove severely affected leaves and follow locally approved disease management.','HIGH'],
    'Late Blight':['92%','Irregular dark lesions on leaves.','Reduce prolonged leaf wetness and follow local disease-management guidance.','HIGH'],
    'Leaf Blast':['91%','Spindle-shaped leaf lesions.','Monitor closely and follow local crop-protection guidance.','HIGH'],
    'Rust':['90%','Rust-like pustules on leaf surfaces.','Scout surrounding plants and use locally recommended management.','MODERATE'],
    'Powdery Mildew':['89%','Powdery growth on leaf surfaces.','Improve airflow and follow locally approved management.','MODERATE'],
    'Downy Mildew':['88%','Downy growth and leaf discoloration.','Reduce prolonged leaf wetness and monitor spread.','MODERATE'],
    'Leaf Spot':['90%','Brown leaf spots visible.','Maintain sanitation and monitor disease spread.','MODERATE'],
    'Wilt':['86%','Wilting/stress pattern requires confirmation.','Inspect roots and soil moisture and seek local diagnosis.','MODERATE'],
    'Mosaic Virus':['85%','Mosaic-like leaf pattern.','Check for vectors and remove severely affected plants where locally advised.','MODERATE'],
    'Yellow Vein Mosaic':['86%','Vein yellowing pattern.','Inspect for whiteflies and follow local IPM guidance.','MODERATE'],
    'Bacterial Blight':['88%','Water-soaked/necrotic leaf symptoms.','Avoid unnecessary leaf wetness and follow local bacterial-disease guidance.','HIGH'],
    'Anthracnose':['87%','Dark sunken lesions may indicate anthracnose.','Remove affected material and improve field sanitation.','MODERATE'],
    'Root Rot':['84%','Root-zone stress pattern.','Check drainage and avoid excess irrigation.','HIGH'],
    'Damping Off':['83%','Seedling collapse/stem-base symptoms.','Improve drainage and avoid overwatering seedlings.','HIGH'],
    'Stem Rot':['85%','Stem lesions/rot symptoms.','Remove affected material and improve sanitation.','HIGH'],
    'Fruit Rot':['84%','Fruit rot symptoms.','Remove affected fruit and reduce prolonged moisture.','MODERATE'],
    'Shoot Borer':['87%','Shoot damage pattern.','Remove damaged shoots and continue pest scouting.','HIGH'],
    'Fruit Borer':['87%','Fruit damage pattern.','Remove damaged fruit and scout regularly.','HIGH'],
    'Stem Borer':['86%','Stem boring damage.','Scout stems and follow integrated pest management.','HIGH'],
    'Bollworm':['88%','Chewing damage and crop stress.','Scout flowers and bolls regularly.','MODERATE'],
    'Fall Armyworm':['88%','Feeding damage, especially on young leaves.','Inspect whorls and follow integrated pest management.','HIGH'],
    'Whitefly Damage':['86%','Sucking-pest damage and leaf stress.','Inspect leaf undersides and monitor populations.','MODERATE'],
    'Thrips Damage':['85%','Silvery scarring or distorted young tissue.','Inspect young leaves and flowers regularly.','MODERATE'],
    'Aphid Damage':['85%','Aphid clusters/leaf distortion.','Scout leaf undersides and manage according to local guidance.','MODERATE'],
    'Jassid Damage':['84%','Leaf-edge yellowing/curling from sucking damage.','Scout leaf undersides and monitor pest levels.','MODERATE'],
    'Leaf Miner Damage':['84%','Serpentine mines visible in leaves.','Remove badly affected leaves and continue scouting.','MODERATE']
  };

  function doAnalysis(){
    const preview=$('preview');
    if(!preview?.src || preview.style.display==='none'){toast('Please take a photo or upload an image first');return;}
    const fileName=(window.__agrishieldCurrentFile||$('imageName')?.textContent||'').replace(/^Selected image:\s*/i,'').trim();
    const inferred=inferFromFilename(fileName);
    const meta=info[inferred.disease]||['—','The image was received successfully. Automatic disease identification needs a connected vision model.','Review the image and use approved local crop-protection guidance before treatment.','LOW'];
    const result={crop:inferred.crop,detection:inferred.disease,confidence:meta[0],symptoms:meta[1],recommendation:meta[2],severity:meta[3],imageName:fileName||'Captured crop image',imageSrc:preview.src};
    const loader=$('loader'),btn=$('analyzeBtn');
    if(loader)loader.style.display='block'; if(btn)btn.disabled=true;
    const old=$('scanWorking'); if(old)old.remove();
    const work=document.createElement('div');work.id='scanWorking';work.className='scan-working';work.innerHTML='<span class="dot"></span><span>Analyzing your image…</span>';
    $('scanResult')?.prepend(work);
    setTimeout(()=>{
      window.latestScan=result; __persistScan(result);
      ['resultCrop','resultDetection','resultConfidence','resultSymptoms','resultRecommendation'].forEach((id,i)=>{const e=$(id);if(e)e.textContent=[result.crop,result.detection,result.confidence,result.symptoms,result.recommendation][i]});
      const sev=$('resultSeverity');if(sev){sev.textContent=result.severity;sev.className='badge '+(result.severity==='HIGH'?'red':result.severity==='MODERATE'?'yellow':'green')}
