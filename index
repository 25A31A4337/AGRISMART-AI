      if(value && !value.dataset.enText)value.dataset.enText=value.textContent;
      if(value)value.textContent=tr(value.dataset.enText,lang);
    }

    const fert=$('fertilizerSuggestion');
    if(fert){
      const h=fert.querySelector('h3');if(h)h.textContent=tr('Fertilizer & Nutrient Suggestions',lang);
      fert.querySelectorAll('.fert-copy b').forEach(el=>{if(!el.dataset.enText)el.dataset.enText=el.textContent;el.textContent=tr(el.dataset.enText,lang)});
      fert.querySelectorAll('.fert-copy span').forEach(el=>{if(!el.dataset.enText)el.dataset.enText=el.textContent;el.textContent=tr(el.dataset.enText,lang)});
      const note=fert.querySelector('.fert-note');if(note){if(!note.dataset.enText)note.dataset.enText=note.textContent;note.textContent=tr(note.dataset.enText,lang);}
      fert.querySelectorAll('.fert-photo-label').forEach(el=>{el.textContent=lang==='te'?'ఉత్పత్తి ఫోటో':lang==='hi'?'उत्पाद फोटो':'Product photo'});
    }

    const adv=$('dynamicAdvisory');
