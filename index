<script>
/* =========================================================
   DYNAMIC HOME DASHBOARD + OPEN LOGIN
   ========================================================= */
(function(){
  const $=id=>document.getElementById(id);
  const read=(key, fallback=[])=>{try{return JSON.parse(localStorage.getItem(key)||JSON.stringify(fallback))||fallback}catch(e){return fallback}};
  const history=()=>read('agrishieldHistory',[]);
  const pests=()=>read('agrishieldPestReports',[]);

  function updateDashboardMetrics(){
    const scans=history();
    const pestReports=pests();
    const latest=scans.length?scans[scans.length-1]:null;
    const count=scans.length;
    if($('scanCount')) $('scanCount').textContent=count;
    if($('profileScanTotal')) $('profileScanTotal').textContent=count;
    if($('profilePestTotal')) $('profilePestTotal').textContent=pestReports.length;

    let health=100, diseaseRisk=0;
    if(latest){
      const sev=String(latest.severity||'').toUpperCase();
      if(sev==='HIGH'){health=55; diseaseRisk=78;}
      else if(sev==='MODERATE'){health=72; diseaseRisk=48;}
      else {health=90; diseaseRisk=18;}
    }
    if($('healthNumber')) $('healthNumber').textContent=health+'%';
    if($('healthBar')) $('healthBar').style.width=health+'%';
    if($('homeDiseaseRisk')) $('homeDiseaseRisk').textContent=diseaseRisk+'%';

    let pestRisk=0;
    if(pestReports.length){
      let total=0;
      pestReports.forEach(r=>{
        const sev=String(r.severity||'').toUpperCase();
        total += sev==='HIGH'?80:sev==='MODERATE'?50:20;
      });
      pestRisk=Math.min(100,Math.round(total/pestReports.length));
    }
    if($('homePestRisk')) $('homePestRisk').textContent=pestRisk+'%';

    const diseaseBadge=$('homeDiseaseRisk')?.parentElement?.querySelector('.badge');
    if(diseaseBadge){
      diseaseBadge.textContent=diseaseRisk>=65?'HIGH':diseaseRisk>=35?'MODERATE':'LOW';
      diseaseBadge.className='badge '+(diseaseRisk>=65?'red':diseaseRisk>=35?'yellow':'green');
    }
    const pestBadge=$('homePestRisk')?.parentElement?.querySelector('.badge');
    if(pestBadge){
      pestBadge.textContent=pestRisk>=65?'HIGH':pestRisk>=35?'MODERATE':'LOW';
      pestBadge.className='badge '+(pestRisk>=65?'red':pestRisk>=35?'yellow':'green');
    }
  }
  window.updateDashboardMetrics=updateDashboardMetrics;

  

  /* Keep dashboard values synchronized after scan/pest changes. */
  const originalShow=window.showSection;
  if(typeof originalShow==='function'){
    window.showSection=function(){const r=originalShow.apply(this,arguments);setTimeout(updateDashboardMetrics,30);return r;};
  }
  document.addEventListener('click',()=>setTimeout(updateDashboardMetrics,50));
  window.addEventListener('storage',updateDashboardMetrics);
  updateDashboardMetrics();
})();
</script>

